#!/bin/bash
# Generates a static, Bootstrap-based HTML directory listing (index.html) for the
# current folder and all of its subfolders, recursively. Inspired by
# https://download.opensuse.org/tumbleweed/repo/oss/
# Any existing index.html is overwritten.
#
# To test the produced HTML files, serve the current directory with:
#   docker run --rm -it -p 8080:80 -v "$(pwd):/usr/share/nginx/html:ro" nginx:alpine
# then open http://localhost:8080

set -euo pipefail

BOOTSTRAP_CSS="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
BOOTSTRAP_JS="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
BOOTSTRAP_ICONS_CSS="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"

ROOT_PATH="$(pwd)"
ROOT_NAME="${ROOT_PATH##*/}"

html_escape() {
  local s="$1"
  s="${s//&/&amp;}"
  s="${s//</&lt;}"
  s="${s//>/&gt;}"
  printf '%s' "$s"
}

# Recursively (re)generates index.html for a directory.
# $1: absolute path of the directory
# $2: path of the directory relative to the root, "" for the root itself
generate_index() {
  local dir="$1"
  local rel_path="$2"
  local index_file="$dir/index.html"

  local title="/$ROOT_NAME"
  [[ -n "$rel_path" ]] && title+="/$rel_path"

  # Build breadcrumb segments: ROOT_NAME, then each part of rel_path.
  local segments=("$ROOT_NAME")
  if [[ -n "$rel_path" ]]; then
    IFS='/' read -r -a rel_parts <<<"$rel_path"
    segments+=("${rel_parts[@]}")
  fi

  local breadcrumb=""
  local total=${#segments[@]}
  local i
  for ((i = 0; i < total; i++)); do
    local escaped_segment up_levels link
    escaped_segment="$(html_escape "${segments[$i]}")"
    up_levels=$((total - 1 - i))
    if ((up_levels > 0)); then
      link=$(printf '../%.0s' $(seq 1 "$up_levels"))
      breadcrumb+="<li class=\"breadcrumb-item\"><a href=\"$link\">$escaped_segment</a></li>"
    else
      breadcrumb+="<li class=\"breadcrumb-item active\" aria-current=\"page\">$escaped_segment</li>"
    fi
  done

  local dir_names=()
  while IFS= read -r -d '' name; do
    dir_names+=("$name")
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\0' | sort -z)

  local file_names=()
  while IFS= read -r -d '' name; do
    file_names+=("$name")
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type f ! -name 'index.html' ! -name '.*' -printf '%f\0' | sort -z)

  {
    cat <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Index of $(html_escape "$title")</title>
<link href="$BOOTSTRAP_CSS" rel="stylesheet">
<link href="$BOOTSTRAP_ICONS_CSS" rel="stylesheet">
</head>
<body>
<div class="container-fluid py-4 px-3 px-md-5">
<nav aria-label="breadcrumb">
<ol class="breadcrumb bg-light rounded-3 px-3 py-2">
$breadcrumb
</ol>
</nav>
<div class="d-flex justify-content-end mb-3">
<input type="search" id="filter" class="form-control" style="max-width: 16rem;" placeholder="Filter...">
</div>
<div class="table-responsive">
<table class="table table-striped table-hover align-middle" id="listing">
<thead>
<tr>
<th scope="col" data-sort-key="name">Name <i class="sort-icon bi"></i></th>
<th scope="col" data-sort-key="mtime">Last modified <i class="sort-icon bi"></i></th>
<th scope="col" data-sort-key="size">Size <i class="sort-icon bi"></i></th>
</tr>
</thead>
<tbody>
HTML

    if [[ -n "$rel_path" ]]; then
      echo '<tr><td><a href="../"><i class="bi bi-arrow-90deg-up me-2"></i>.. (Parent Directory)</a></td><td></td><td></td></tr>'
    fi

    local order_index=0

    for name in "${dir_names[@]}"; do
      local escaped_name mtime mtime_epoch
      escaped_name="$(html_escape "$name")"
      mtime=$(stat -c '%y' "$dir/$name" | cut -d'.' -f1)
      mtime_epoch=$(stat -c '%Y' "$dir/$name")
      echo "<tr data-type=\"dir\" data-name=\"$escaped_name\" data-mtime=\"$mtime_epoch\" data-size=\"-1\" data-index=\"$order_index\"><td><a href=\"$escaped_name/\"><i class=\"bi bi-folder-fill me-2\"></i>$escaped_name/</a></td><td>$mtime</td><td>-</td></tr>"
      order_index=$((order_index + 1))
    done

    for name in "${file_names[@]}"; do
      local escaped_name mtime mtime_epoch size size_bytes
      escaped_name="$(html_escape "$name")"
      mtime=$(stat -c '%y' "$dir/$name" | cut -d'.' -f1)
      mtime_epoch=$(stat -c '%Y' "$dir/$name")
      size_bytes=$(stat -c '%s' "$dir/$name")
      size=$(numfmt --to=iec --suffix=B "$size_bytes")
      echo "<tr data-type=\"file\" data-name=\"$escaped_name\" data-mtime=\"$mtime_epoch\" data-size=\"$size_bytes\" data-index=\"$order_index\"><td><a href=\"$escaped_name\"><i class=\"bi bi-file-earmark-text me-2\"></i>$escaped_name</a></td><td>$mtime</td><td>$size</td></tr>"
      order_index=$((order_index + 1))
    done

    cat <<HTML
</tbody>
</table>
</div>
</div>
<script src="$BOOTSTRAP_JS"></script>
<script>
(function () {
  var table = document.getElementById('listing');
  var tbody = table.tBodies[0];
  var headers = table.querySelectorAll('th[data-sort-key]');
  var currentKey = null;
  var currentDir = 1;

  function clearIndicators() {
    headers.forEach(function (h) {
      h.querySelector('.sort-icon').className = 'sort-icon bi';
    });
  }

  function sortBy(key, dir) {
    var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr[data-type]'));
    rows.sort(function (a, b) {
      if (a.dataset.type !== b.dataset.type) {
        return a.dataset.type === 'dir' ? -1 : 1;
      }
      var va = a.dataset[key];
      var vb = b.dataset[key];
      if (key === 'name') {
        va = va.toLowerCase();
        vb = vb.toLowerCase();
      } else {
        va = Number(va);
        vb = Number(vb);
      }
      if (va < vb) return -1 * dir;
      if (va > vb) return 1 * dir;
      return 0;
    });
    rows.forEach(function (row) {
      tbody.appendChild(row);
    });
  }

  headers.forEach(function (h) {
    h.style.cursor = 'pointer';
    h.addEventListener('click', function () {
      var key = h.dataset.sortKey;
      if (currentKey !== key) {
        currentKey = key;
        currentDir = 1;
      } else if (currentDir === 1) {
        currentDir = -1;
      } else {
        currentKey = null;
        currentDir = 0;
      }
      clearIndicators();
      if (currentKey === null) {
        sortBy('index', 1);
      } else {
        h.querySelector('.sort-icon').className =
          'sort-icon bi ' + (currentDir === 1 ? 'bi-caret-up-fill' : 'bi-caret-down-fill');
        sortBy(currentKey, currentDir);
      }
    });
  });

  var filterInput = document.getElementById('filter');
  filterInput.addEventListener('input', function () {
    var query = filterInput.value.toLowerCase();
    tbody.querySelectorAll('tr[data-type]').forEach(function (row) {
      row.style.display = row.dataset.name.toLowerCase().indexOf(query) === -1 ? 'none' : '';
    });
  });
})();
</script>
</body>
</html>
HTML
  } > "$index_file"

  echo "Generated $index_file"

  for name in "${dir_names[@]}"; do
    local child_rel="$name"
    [[ -n "$rel_path" ]] && child_rel="$rel_path/$name"
    generate_index "$dir/$name" "$child_rel"
  done
}

generate_index "$ROOT_PATH" ""
